{
  "name": "ponto-previsao",
  "version": "1.0.0",
  "description": "Aplicação desktop de previsão de batimento de ponto",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.procergs.ponto",
    "productName": "PrevisaoPonto",
    "files": [
      "main.js",
      "../ponto.html"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "allowScripts": {
    "electron@28.0.0": true
  },
  "dependencies": {
    "ajv-keywords": "^5.1.0",
    "asynckit": "^0.5.0",
    "bluebird": "^3.5.1",
    "bluebird-lst": "^1.0.9",
    "electron-packager": "^17.1.2",
    "fs-extra": "^11.4.1",
    "source-map": "^0.8.0"
  }
}
